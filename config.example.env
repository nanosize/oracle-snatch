# Copy to config.env for local execution. Environment variables override this file.
# The Docker Compose example uses .env instead; see .env.example.

# Required: subnet OCID in the tenancy home region.
SUBNET_ID=ocid1.subnet.oc1..replace-with-your-subnet
SSH_PUBLIC_KEY_FILE=~/.ssh/id_ed25519.pub

# Optional: defaults to the tenancy root compartment. Inventory is always
# scanned across the whole tenancy, including child compartments.
# COMPARTMENT_ID=ocid1.compartment.oc1..replace-with-your-compartment

# Optional: leave empty to select the newest compatible Canonical Ubuntu image.
# IMAGE_ID=ocid1.image.oc1..replace-with-your-image

# FREE is the safe default for free/trial accounts: 2 OCPU / 12 GB total.
# Set PAYG only for a Pay As You Go tenancy after confirming its free allowance.
ACCOUNT_TYPE=FREE
# Set ACCOUNT_TYPE=PAYG and this to YES only after checking OCI Console billing.
# PAYG_FREE_LIMITS_CONFIRMED=YES
DISPLAY_NAME=snatch-arm
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=50

# One serial pass through ADs, then wait. Values below 120 seconds are rejected.
INTERVAL_SECONDS=120

# Standard OCI SDK config and profile. Credentials must not be copied into Git.
OCI_CONFIG_FILE=~/.oci/config
OCI_PROFILE=DEFAULT

# Persistent JSON state and result files. Keep these on durable storage.
STATE_FILE=./data/state.json
RESULT_FILE=./data/snatched.json

# Optional Telegram notifications: set both or neither.
# TG_BOT_TOKEN=
# TG_CHAT_ID=

# Optional Discord webhook.
# DISCORD_WEBHOOK_URL=
