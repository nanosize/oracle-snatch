# Copy to .env. The OCI key file named inside config must be mounted in this directory.
OCI_CONFIG_DIR=./secrets/oci
SSH_PUBLIC_KEY_HOST_PATH=./secrets/ssh_authorized_keys.pub
DATA_DIR=./data

# Set these to the owning user/group of the mounted files and data directory.
# On Debian, run: id -u && id -g
PUID=10001
PGID=10001

# Required settings.
SUBNET_ID=ocid1.subnet.oc1..replace-with-your-subnet
ACCOUNT_TYPE=FREE
# If using ACCOUNT_TYPE=PAYG, verify the allowance in OCI Console and set:
# PAYG_FREE_LIMITS_CONFIRMED=YES
DISPLAY_NAME=snatch-arm
OCPUS=2
MEMORY_GB=12
BOOT_VOLUME_GB=50
INTERVAL_SECONDS=120
OCI_PROFILE=DEFAULT

# Optional.
# COMPARTMENT_ID=ocid1.compartment.oc1..replace-with-your-compartment
# IMAGE_ID=ocid1.image.oc1..replace-with-your-image
# TG_BOT_TOKEN=
# TG_CHAT_ID=
# DISCORD_WEBHOOK_URL=
